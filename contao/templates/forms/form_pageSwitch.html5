<?php
  use Contao\StringUtil;

  $this->extend('form_row');
?>

<?php $this->block('field'); ?>

<?php if ($this->src): ?>
  <input type="image" src="<?= $this->src ?>" title="<?= StringUtil::specialchars($this->slabel) ?>" alt="<?= StringUtil::specialchars($this->slabel) ?>">
<?php else: ?>
  <button type="submit" name="pageSwitch" value="continue"><?= $this->slabel ?></button>
<?php endif; ?>

<?php if ($this->blabel): ?>
  <button type="submit" name="pageSwitch" value="back" formnovalidate><?= $this->blabel ?></button>
<?php endif; ?>

<?php $this->endblock(); ?>
